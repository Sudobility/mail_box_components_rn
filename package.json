{
  "name": "@sudobility/components-rn",
  "version": "1.0.134",
  "description": "React Native UI components and design system - Ported from @sudobility/components",
  "type": "module",
  "main": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "codegenConfig": {
    "name": "MoosiacNativeSliderSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "ios": {
      "componentProvider": {
        "MoosiacNativeSlider": "MoosiacNativeSliderComponentView"
      }
    },
    "windows": {
      "namespace": "MoosiacSliderCodegen",
      "generators": [
        "componentsWindows"
      ],
      "outputDirectory": "windows/codegen",
      "separateDataTypes": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.esm.js",
      "default": "./dist/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "macos",
    "windows",
    "mail_box_components_rn.podspec",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test:unit": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "react-native",
    "components",
    "ui",
    "design-system",
    "typescript",
    "nativewind",
    "tailwind"
  ],
  "author": "Sudobility",
  "peerDependencies": {
    "@react-native-community/slider": "^4.5.1",
    "@react-navigation/native": ">=7.0.0",
    "@react-navigation/native-stack": ">=7.0.0",
    "react-native-screens": ">=4.0.0",
    "@sudobility/design": "^1.1.66",
    "@sudobility/types": "^1.9.76",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "nativewind": ">=4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.72.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-svg": ">=13.0.0",
    "tailwind-merge": ">=2.0.0"
  },
  "devDependencies": {
    "@react-native-community/slider": "~5.2.2",
    "@babel/core": "~7.29.7",
    "@babel/preset-env": "~7.29.7",
    "@babel/preset-flow": "~7.29.7",
    "@babel/preset-react": "~7.29.7",
    "@babel/preset-typescript": "~7.29.7",
    "@babel/runtime": "~7.29.10",
    "@eslint/js": "~10.0.1",
    "@react-native/babel-preset": "~0.83.10",
    "@react-native/js-polyfills": "~0.83.10",
    "@react-native/normalize-colors": "~0.83.10",
    "@react-navigation/native": "~7.5.1",
    "@react-navigation/native-stack": "~7.21.0",
    "react-native-screens": "~4.24.0",
    "@sudobility/design": "^1.1.66",
    "@sudobility/types": "^1.9.76",
    "@testing-library/jest-native": "~5.4.3",
    "@testing-library/react-native": "~13.3.3",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.3.0",
    "@types/react-native": "~0.73.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "ajv": "~8.20.0",
    "babel-jest": "~30.5.2",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "~30.5.2",
    "nativewind": "~4.2.7",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-native": "~0.83.10",
    "react-test-renderer": "19.3.1",
    "tailwind-merge": "~3.7.0",
    "typescript": "~6.0.3",
    "vite": "~8.3.5",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "~4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/mail_box_components_rn.git"
  },
  "bugs": {
    "url": "https://github.com/sudobility/components-rn/issues"
  },
  "homepage": "https://github.com/sudobility/components-rn#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "BUSL-1.1"
}
